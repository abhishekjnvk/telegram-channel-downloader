<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= channelName || 'Channel' %> — Messages</title>
    <style>
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        background: #f5f5f5;
        color: #212529;
        line-height: 1.5;
        padding: 20px;
      }
      .container { max-width: 720px; margin: 0 auto; }
      h1 {
        text-align: center;
        color: #3390ec;
        margin-bottom: 8px;
        font-size: 1.5rem;
      }
      .subtitle {
        text-align: center;
        color: #707579;
        font-size: 0.9rem;
        margin-bottom: 24px;
      }
      .message {
        background: #ffffff;
        border-radius: 12px;
        padding: 12px 16px;
        margin-bottom: 8px;
        box-shadow: 0 1px 2px rgba(0,0,0,0.08);
        max-width: 85%;
      }
      .message.outgoing { margin-left: auto; background: #effdde; }
      .message-header {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        margin-bottom: 4px;
      }
      .sender { font-weight: 600; color: #3390ec; font-size: 0.85rem; }
      .date { font-size: 0.75rem; color: #707579; white-space: nowrap; margin-left: 12px; }
      .text { font-size: 0.95rem; word-break: break-word; white-space: pre-wrap; }
      .text a { color: #3390ec; text-decoration: none; }
      .text a:hover { text-decoration: underline; }
      .media-badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        background: #f0f0f0;
        border-radius: 6px;
        padding: 4px 10px;
        font-size: 0.8rem;
        color: #707579;
        margin-top: 6px;
      }
      .media-badge a { color: #3390ec; text-decoration: none; }
      .stats {
        text-align: center;
        color: #707579;
        font-size: 0.85rem;
        margin-top: 24px;
        padding-top: 16px;
        border-top: 1px solid #e0e0e0;
      }
      .media-icon { font-size: 1rem; }
    </style>
  </head>
  <body>
    <div class="container">
      <h1><%= channelName || 'Channel Messages' %></h1>
      <div class="subtitle">
        Exported on <%= new Date().toLocaleDateString('en-GB', { day: '2-digit', month: 'long', year: 'numeric' }) %>
        · <%= messages.length %> messages
      </div>

      <% messages.forEach(function(msg) { %>
        <div class="message <%= msg.out ? 'outgoing' : '' %>">
          <div class="message-header">
            <span class="sender">
              <% if (msg.out) { %>You<% } else if (msg.sender) { %>User <%= msg.sender %><% } else { %>Unknown<% } %>
            </span>
            <span class="date">
              <%= new Date(msg.date * 1000).toLocaleString('en-GB', {
                day: '2-digit', month: 'short', year: 'numeric',
                hour: '2-digit', minute: '2-digit'
              }) %>
            </span>
          </div>
          <% if (msg.message) { %>
            <div class="text"><%- msg.message %></div>
          <% } %>
          <% if (msg.hasMedia && msg.mediaName) { %>
            <div class="media-badge">
              <span class="media-icon">
                <% if (msg.mediaType === 'image') { %>🖼️<% } %>
                <% if (msg.mediaType === 'video') { %>🎬<% } %>
                <% if (msg.mediaType === 'audio') { %>🎵<% } %>
                <% if (msg.mediaType === 'document' || msg.mediaType === 'pdf') { %>📄<% } %>
                <% if (msg.mediaType === 'sticker') { %>😀<% } %>
                <% if (!['image','video','audio','document','pdf','sticker'].includes(msg.mediaType)) { %>📎<% } %>
              </span>
              <span><%= msg.mediaName %></span>
            </div>
          <% } %>
        </div>
      <% }); %>

      <div class="stats">
        <%= messages.filter(m => m.hasMedia).length %> with media
        · <%= messages.length %> total
      </div>
    </div>
  </body>
</html>
